modules = ["html"]

entrypoint = "index.html"
run = "python3 -m http.server 5000 --bind 0.0.0.0"

hidden = [".git"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python3 -m http.server $PORT --bind 0.0.0.0"]
deploymentTarget = "static"

[[ports]]
localPort = 5000
externalPort = 80
